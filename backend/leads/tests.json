{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST without required fields",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "GET without owner_id",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "GET by owner_id without X-User-Id header returns 403",
      "method": "GET",
      "path": "/?owner_id=00000000-0000-0000-0000-000000000001",
      "expectedStatus": 403
    },
    {
      "name": "GET by owner_id with wrong X-User-Id returns 403",
      "method": "GET",
      "path": "/?owner_id=00000000-0000-0000-0000-000000000001",
      "headers": { "X-User-Id": "00000000-0000-0000-0000-000000000002" },
      "expectedStatus": 403
    },
    {
      "name": "DELETE without params",
      "method": "DELETE",
      "path": "/",
      "expectedStatus": 400
    }
  ]
}