{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET без X-User-Id — ошибка 401",
      "method": "GET",
      "path": "/?action=list_my_orgs",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET список организаций — успех",
      "method": "GET",
      "path": "/?action=list_my_orgs",
      "headers": {"X-User-Id": "00000000-0000-0000-0000-000000000001"},
      "expectedStatus": 200
    },
    {
      "name": "Неизвестный action — ошибка 400",
      "method": "GET",
      "path": "/?action=unknown_xyz",
      "headers": {"X-User-Id": "00000000-0000-0000-0000-000000000001"},
      "expectedStatus": 400
    },
    {
      "name": "create_org без name — ошибка 400",
      "method": "POST",
      "path": "/?action=create_org",
      "headers": {"X-User-Id": "00000000-0000-0000-0000-000000000001"},
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "invite_employee без email — ошибка 400",
      "method": "POST",
      "path": "/?action=invite_employee",
      "headers": {"X-User-Id": "00000000-0000-0000-0000-000000000001", "X-Org-Id": "00000000-0000-0000-0000-000000000001"},
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "fire_employee без user_id — ошибка 400",
      "method": "POST",
      "path": "/?action=fire_employee",
      "headers": {"X-User-Id": "00000000-0000-0000-0000-000000000001", "X-Org-Id": "00000000-0000-0000-0000-000000000001"},
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "get_org несуществующей организации — ошибка 403",
      "method": "GET",
      "path": "/?action=get_org&org_id=00000000-0000-0000-0000-000000000099",
      "headers": {"X-User-Id": "00000000-0000-0000-0000-000000000001"},
      "expectedStatus": 403
    }
  ]
}