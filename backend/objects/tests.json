{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET marketplace objects",
      "method": "GET",
      "path": "/?marketplace=true",
      "expectedStatus": 200
    },
    {
      "name": "GET archive objects",
      "method": "GET",
      "path": "/?archive=true",
      "expectedStatus": 200
    },
    {
      "name": "GET by user_id without X-User-Id header returns 403",
      "method": "GET",
      "path": "/?user_id=00000000-0000-0000-0000-000000000001",
      "expectedStatus": 403
    },
    {
      "name": "GET by user_id with wrong X-User-Id returns 403",
      "method": "GET",
      "path": "/?user_id=00000000-0000-0000-0000-000000000001",
      "headers": { "X-User-Id": "00000000-0000-0000-0000-000000000002" },
      "expectedStatus": 403
    },
    {
      "name": "GET object by id returns 200",
      "method": "GET",
      "path": "/?id=e08f69e0-09f7-4092-a822-58aeb170229b",
      "expectedStatus": 200
    },
    {
      "name": "GET object by unknown id returns 404",
      "method": "GET",
      "path": "/?id=00000000-0000-0000-0000-000000000000",
      "expectedStatus": 404
    },
    {
      "name": "DELETE without params",
      "method": "DELETE",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "PUT without body",
      "method": "PUT",
      "path": "/",
      "expectedStatus": 400
    }
  ]
}