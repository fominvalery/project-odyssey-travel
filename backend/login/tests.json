{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST без пароля — ошибка 400",
      "method": "POST",
      "path": "/",
      "body": {"email": "test@example.com"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "POST без email — ошибка 400",
      "method": "POST",
      "path": "/",
      "body": {"password": "somepass"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "POST с несуществующим email — ошибка 401",
      "method": "POST",
      "path": "/",
      "body": {"email": "notexist_xyz@example.com", "password": "wrongpass"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "POST с неверным паролем — ошибка 401",
      "method": "POST",
      "path": "/",
      "body": {"email": "test@test.com", "password": "totally_wrong_password_xyz"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    }
  ]
}
