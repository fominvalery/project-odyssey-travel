    },
    {
      "name": "GET с фильтром по городу",
      "method": "GET",
      "path": "/?user_id=00000000-0000-0000-0000-000000000001&city=Москва",
      "expectedStatus": 200,
      "expectedBody": {"members": []},
      "bodyMatcher": "partial"
    }
  ]
