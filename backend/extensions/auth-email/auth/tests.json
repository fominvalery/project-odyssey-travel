      "path": "/?action=pay-with-balance",
      "body": {"months": 1},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Pay with balance с некорректным периодом — ошибка 400",
      "method": "POST",
      "path": "/?action=pay-with-balance",
      "body": {"user_id": "00000000-0000-0000-0000-000000000001", "months": 99},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Pay with balance — недостаточно баллов у несуществующего user — ошибка 400",
