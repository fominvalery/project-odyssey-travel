      "path": "/?action=withdrawal-request",
      "body": {"user_id": "00000000-0000-0000-0000-000000000001"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Withdrawal request несуществующего user — ошибка 404",
      "method": "POST",
      "path": "/?action=withdrawal-request",
